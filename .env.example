# API. Use .env at the workspace root or set these in the API process.
# The loopback addresses below use Supabase CLI's local development ports.
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional previous web origin during a custom-domain migration.
PREVIOUS_WEB_ORIGIN=
# Optional exact HTTPS origin of a Touchlumo testing frontend.
CRM_ORIGIN=
# Set to true only for a CRM test deployment sharing the same Supabase project.
TOUCHLUMO_ENABLED=false

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional privileged connection for the migration command only.
MIGRATION_DATABASE_URL=
# The test project's PostgreSQL CA, as base64 PEM or a mounted file path.
DATABASE_CA_BASE64=
DATABASE_CA_FILE=

# Private document bucket. Cloud Run uses its attached service account.
# A host outside Google Cloud can supply its server credential below.
GCS_BUCKET=
GCS_CREDENTIALS_BASE64=
# Generate and securely retain a unique random secret (at least 32 bytes).
LINK_SECRET=

# Omitting email credentials enables manual link sharing.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=
# Process durable database jobs while the API is running.
JOBS_INLINE=true

# Browser build. Copy these three settings to apps/web/.env.local for Next.js.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
