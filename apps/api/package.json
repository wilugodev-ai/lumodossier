{
  "name": "@lumo/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "jobs": "node --env-file-if-exists=../../.env dist/jobs-cli.js",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "e2e": "tsx test/e2e/run.ts",
    "preview:local": "tsx test/e2e/run.ts --preview"
  },
  "dependencies": {
    "@google-cloud/storage": "8.4.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@cantoo/fontkit": "2.0.12",
    "pdf-lib": "npm:@cantoo/pdf-lib@2.11.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
