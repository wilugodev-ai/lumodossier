{
  "templates": [
    {
      "id": "fl-exclusive-right-of-sale",
      "title": "Exclusive Right of Sale Listing Agreement",
      "kind": "sale",
      "description": "One listing brokerage earns the agreed fee on a qualifying sale, whoever finds the buyer."
    },
    {
      "id": "fl-exclusive-agency-listing",
      "title": "Exclusive Agency Listing Agreement",
      "kind": "sale",
      "description": "One listing brokerage markets the property. The owner retains the independent-sale exception."
    },
    {
      "id": "fl-open-listing",
      "title": "Open Listing Agreement",
      "kind": "sale",
      "description": "The owner may engage several brokers. This brokerage earns its fee when it procures the buyer."
    },
    {
      "id": "fl-rental-listing",
      "title": "Residential Rental Listing Agreement",
      "kind": "rental",
      "description": "A landlord appoints a brokerage to find a tenant and chooses the type of rental listing."
    },
    {
      "id": "fl-broker-referral",
      "title": "Broker-to-Broker Referral Agreement",
      "kind": "referral",
      "description": "Two licensed brokerages agree on a client introduction, the referral fee, and payment timing."
    }
  ],
